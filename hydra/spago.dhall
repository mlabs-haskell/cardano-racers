{ name = "cardano-racers-hydra"
, dependencies =
  [ "aeson"
  , "aff"
  , "affjax"
  , "arrays"
  , "avar"
  , "bifunctors"
  , "bytearrays"
  , "cardano-provider"
  , "cardano-racers-offchain"
  , "cardano-transaction-lib"
  , "cardano-types"
  , "codec-aeson"
  , "console"
  , "datetime"
  , "effect"
  , "either"
  , "errors"
  , "exceptions"
  , "foldable-traversable"
  , "http-methods"
  , "httpure"
  , "hydra-sdk"
  , "maybe"
  , "monad-logger"
  , "newtype"
  , "node-buffer"
  , "node-child-process"
  , "node-fs-aff"
  , "node-path"
  , "node-process"
  , "ordered-collections"
  , "parallel"
  , "partial"
  , "plutus-types"
  , "posix-types"
  , "prelude"
  , "profunctor"
  , "profunctor-lenses"
  , "record"
  , "refs"
  , "strings"
  , "tailrec"
  , "transformers"
  , "tuples"
  , "uint"
  , "uri"
  , "variant"
  ]
, packages = ./packages.dhall
, sources =
  [ "app/**/*.purs", "demo/**/*.purs", "src/**/*.purs", "test/**/*.purs" ]
}
