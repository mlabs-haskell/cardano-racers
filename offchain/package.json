{
  "type": "module",
  "name": "cardano-racers",
  "version": "0.1.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "spago run --main Test.CardanoRacers.Main",
    "start-blockfrost-runtime": "nix run -L .#ctl-scaffold-blockfrost-runtime",
    "start-runtime": "nix run -L .#ctl-scaffold-runtime",
    "test-unit": "spago run --main Test.CardanoRacers.Unit",
    "e2e-serve": "make esbuild-serve",
    "e2e-test": "source ./test/e2e.env && spago test --main CardanoRacers.Test.E2E -a 'run'",
    "e2e-test-debug": "source ./test/e2e.env && spago test --main CardanoRacers.Test.E2E -a 'run --no-headless'",
    "e2e-browser": "source ./test/e2e.env && spago run --main CardanoRacers.Test.E2E -a 'browser'",
    "e2e-pack-settings": "source ./test/e2e.env && spago run --main CardanoRacers.Test.E2E -a 'e2e-test pack'",
    "e2e-unpack-settings": "source ./test/e2e.env && spago run --main CardanoRacers.Test.E2E -a 'e2e-test unpack'",
    "dev": "make run-dev",
    "build": "make run-build"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@emurgo/cardano-message-signing-browser": "1.0.1",
    "@emurgo/cardano-message-signing-nodejs": "1.0.1",
    "@mlabs-haskell/csl-gc-wrapper": "^1.0.1",
    "apply-args-browser": "0.0.1",
    "apply-args-nodejs": "0.0.1",
    "big-integer": "1.6.51",
    "blakejs": "1.2.1",
    "jssha": "3.2.0",
    "node-polyfill-webpack-plugin": "1.1.4",
    "@mlabs-haskell/cardano-message-signing": "^1.0.1",
    "@mlabs-haskell/cardano-serialization-lib-gc": "12.0.0",
    "@mlabs-haskell/json-bigint": "2.0.0",
    "@mlabs-haskell/uplc-apply-args": "1.0.29-alpha",
    "@noble/secp256k1": "^1.7.0",
    "base64-js": "^1.5.1",
    "bignumber.js": "^9.1.1",
    "bip39": "^3.1.0",
    "bufferutil": "4.0.5",
    "isomorphic-ws": "^5.0.0",
    "puppeteer-core": "^15.3.2",
    "reconnecting-websocket": "4.4.0",
    "uniqid": "5.4.0",
    "utf-8-validate": "^5.0.10",
    "web-encoding": "^1.1.5",
    "ws": "^8.16.0",
    "xhr2": "0.2.1"
  },
  "devDependencies": {
    "html-webpack-plugin": "5.5.0",
    "@eslint/js": "^9.7.0",
    "blakejs": "1.2.1",
    "buffer": "6.0.3",
    "doctoc": "^2.2.1",
    "esbuild": "0.18.11",
    "esbuild-plugin-polyfill-node": "^0.3.0",
    "esbuild-plugin-wasm": "^1.1.0",
    "globals": "^15.8.0",
    "jssha": "3.2.0",
    "node-polyfill-webpack-plugin": "2.0.1",
    "webpack": "5.88.1",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "4.15.1"
  },
  "prettier": {
    "arrowParens": "avoid"
  }
}
